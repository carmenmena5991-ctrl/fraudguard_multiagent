# Copie este archivo a .env y complete los valores. .env NO se sube a GitHub.

# Credencial de la API de Claude. Sin ella, el sistema corre en modo determinista
# (la zona gris se escala al analista y el informe usa la plantilla).
ANTHROPIC_API_KEY=

# auto (usa LLM si hay credencial) | on | off
FRAUDGUARD_LLM=auto
FRAUDGUARD_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
FRAUDGUARD_EFFORT=medium
# Reintento automático en modelo de respaldo si el modelo declina por política (on | off)
FRAUDGUARD_FALLBACKS=on

# Salt del hashing SHA-256 de identificadores
FRAUDGUARD_HASH_SALT=cambie-este-valor
